<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode"/>
    </handlers>
    <rewrite>
      <rules>
        <rule name="iisnodeLogs" stopProcessing="true">
          <match url="^app\.js\.logs\/\d+\.txt$" />
          <action type="None" />
        </rule>
        <rule name="NodeJS" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js"/>
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".baileys_auth" />
          <add segment="data" />
          <add segment="tmp" />
          <add segment=".puppeteer_cache" />
          <add segment="iisnode" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <iisnode
      flushResponse="true"
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config"
      loggingEnabled="true"
      devErrorsEnabled="false" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
